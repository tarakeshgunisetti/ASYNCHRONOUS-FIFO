module wr_ptr_handler#(parameter N=4)(input wr_clk,wr_rst,wr_en,
                                      input [N:0] gray_rd_ptr_sync,
                                      output reg [N:0] bin_wr_ptr,
                                      output reg [N:0] gray_wr_ptr,
                                      output reg full);
wire [N:0] gray_wr_ptr_next;
wire [N:0] bin_wr_ptr_next;
wire full_next;

  // Next binary pointer
assign bin_wr_ptr_next = bin_wr_ptr + (wr_en & ~full);
  
  // Binary -> Gray conversion
assign gray_wr_ptr_next = (bin_wr_ptr_next^(bin_wr_ptr_next>>1));
  
  //full detection
  assign full_next = (gray_wr_ptr_next =={~gray_rd_ptr_sync[N:N-1],gray_rd_ptr_sync[N-2:0]});
  
  always @(posedge wr_clk or posedge wr_rst )
    begin
      if(wr_rst)
        begin
          full<=0;
          gray_wr_ptr <= 0;
          bin_wr_ptr<=0;
        end
      else 
        begin
          bin_wr_ptr<=bin_wr_ptr_next;
          gray_wr_ptr<=gray_wr_ptr_next;
          full<=full_next;
        end
    end
endmodule
